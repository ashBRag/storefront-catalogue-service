# Copy to .env and adjust. Every value here is a safe local default; no secrets belong in this file.
# Blank values count as unset, so the backend's built-in default applies.

# --- Backend ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=3000

# --- Product source --------------------------------------------------------
# Base URL of the upstream product API. Only the backend's product adapter uses it.
PRODUCT_API_BASE_URL=https://fakestoreapi.com
# Products the owner has chosen as "top rated" for the home page, in display order.
# Comma-separated ids, e.g. 9,1,14,3,5. Leave blank to use the highest-rated products.
FEATURED_PRODUCT_IDS=
# How many featured products the home page shows (1-20).
FEATURED_COUNT=5

# --- Email (enquiries) -----------------------------------------------------
# Defaults point at Mailpit, a local inbox: open http://localhost:8025 to see sent mail.
# Inside docker compose the host is "mailpit".
SMTP_HOST=localhost
SMTP_PORT=1025
# Set both or neither. Mailpit needs no credentials. Put real ones only in your untracked .env.
SMTP_USER=
SMTP_PASS=
# Sender address on enquiry emails.
MAIL_FROM=catalogue@example.test
# The sales inbox that receives enquiries.
SALES_INBOX=sales@example.test
